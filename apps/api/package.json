{
  "name": "@budget-flow/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "pnpm run build && concurrently --kill-others-on-fail \"pnpm run dev:build\" \"pnpm run dev:server\"",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:server": "node --watch dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.3"
  }
}
